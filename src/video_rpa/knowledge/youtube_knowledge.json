{
  "version": "1.0.0",
  "platform": "youtube",
  "steps": {
    "continue_button": {
      "name": "繼續工作室按鈕",
      "timeout": 5,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//h1[text()='頻道資訊主頁']",
          "weight": 30
        },
        {
          "by": "xpath",
          "value": "//tp-yt-paper-button[@id='button' and .//div[contains(text(),'Continue') or contains(text(),'繼續')]]",
          "weight": 10
        }
      ]
    },
    "upload_button": {
      "name": "建立/上傳按鈕",
      "timeout": 8,
      "locators": [
        {
          "by": "xpath",
          "value": "//ytcp-icon-button[@id='create-icon']",
          "weight": 10
        },
        {
          "by": "xpath",
          "value": "//ytcp-quick-actions//ytcp-icon-button",
          "weight": 32
        },
        {
          "by": "xpath",
          "value": "//tp-yt-paper-button[.//div[contains(text(),'建立') or contains(text(),'Create')]]",
          "weight": 8
        },
        {
          "by": "xpath",
          "value": "//*[@id='create-icon']",
          "weight": 7
        }
      ]
    },
    "select_upload_option": {
      "name": "上傳影片選單選項",
      "timeout": 6,
      "locators": [
        {
          "by": "xpath",
          "value": "//tp-yt-paper-item[.//div[contains(text(),'Upload videos') or contains(text(),'上傳影片')]]",
          "weight": 10
        },
        {
          "by": "xpath",
          "value": "//ytcp-text-menu//tp-yt-paper-item[1]",
          "weight": 6
        }
      ]
    },
    "file_input": {
      "name": "上傳檔案輸入框",
      "timeout": 10,
      "locators": [
        {
          "by": "xpath",
          "value": "//input[@type='file']",
          "weight": 32
        }
      ]
    },
    "title_input": {
      "name": "影片標題輸入框",
      "timeout": 15,
      "locators": [
        {
          "by": "xpath",
          "value": "//ytcp-social-suggestions-textbox[@id='title-textarea']//div[@id='textbox']",
          "weight": 28
        },
        {
          "by": "xpath",
          "value": "//div[@id='title-textarea']//*[@id='textbox']",
          "weight": 8
        },
        {
          "by": "xpath",
          "value": "//*[@id='textbox' and @contenteditable='true']",
          "weight": 9
        }
      ]
    },
    "description_input": {
      "name": "影片說明輸入框",
      "timeout": 10,
      "locators": [
        {
          "by": "xpath",
          "value": "//ytcp-social-suggestions-textbox[@id='description-textarea']//div[@id='textbox']",
          "weight": 32
        },
        {
          "by": "xpath",
          "value": "//div[@id='description-textarea']//*[@id='textbox']",
          "weight": 8
        }
      ]
    },
    "playlist_trigger": {
      "name": "播放清單下拉選單",
      "timeout": 8,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//ytcp-text-dropdown-trigger//div[contains(@class, 'right-container')]",
          "weight": 32
        },
        {
          "by": "xpath",
          "value": "//ytcp-text-dropdown-trigger",
          "weight": 8
        }
      ]
    },
    "playlist_done_button": {
      "name": "播放清單完成按鈕",
      "timeout": 6,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//ytcp-button[.//div[contains(text(), 'Done') or contains(text(), '完成')]]",
          "weight": 32
        }
      ]
    },
    "kids_restriction_not_for_kids": {
      "name": "非兒童專屬設定",
      "timeout": 10,
      "locators": [
        {
          "by": "xpath",
          "value": "//tp-yt-paper-radio-button[@name='VIDEO_MADE_FOR_KIDS_NOT_MFK']",
          "weight": 32
        },
        {
          "by": "xpath",
          "value": "//tp-yt-paper-radio-button[.//div[contains(text(), 'Not made for kids') or contains(text(), '不是專為兒童打造')]]",
          "weight": 8
        }
      ]
    },
    "next_button": {
      "name": "嚮導下一步按鈕",
      "timeout": 10,
      "locators": [
        {
          "by": "xpath",
          "value": "//*[@id='next-button']",
          "weight": 76
        },
        {
          "by": "xpath",
          "value": "//ytcp-button[@id='next-button']",
          "weight": 9
        },
        {
          "by": "xpath",
          "value": "//button[.//div[contains(text(), '下一步') or contains(text(), 'Next')]]",
          "weight": 7
        }
      ]
    },
    "visibility_public": {
      "name": "公開性選項 - 公開",
      "timeout": 8,
      "locators": [
        {
          "by": "xpath",
          "value": "//tp-yt-paper-radio-button[@name='PUBLIC']",
          "weight": 32
        },
        {
          "by": "xpath",
          "value": "//tp-yt-paper-radio-button[.//div[contains(text(), '公開') or contains(text(), 'Public')]]",
          "weight": 8
        }
      ]
    },
    "visibility_unlisted": {
      "name": "公開性選項 - 不公開",
      "timeout": 8,
      "locators": [
        {
          "by": "xpath",
          "value": "//tp-yt-paper-radio-button[@name='UNLISTED']",
          "weight": 10
        },
        {
          "by": "xpath",
          "value": "//tp-yt-paper-radio-button[.//div[contains(text(), '不公開') or contains(text(), 'Unlisted')]]",
          "weight": 8
        }
      ]
    },
    "visibility_private": {
      "name": "公開性選項 - 私人",
      "timeout": 8,
      "locators": [
        {
          "by": "xpath",
          "value": "//tp-yt-paper-radio-button[@name='PRIVATE']",
          "weight": 10
        },
        {
          "by": "xpath",
          "value": "//tp-yt-paper-radio-button[.//div[contains(text(), '私人') or contains(text(), 'Private')]]",
          "weight": 8
        }
      ]
    },
    "done_button": {
      "name": "完成/發布按鈕",
      "timeout": 15,
      "locators": [
        {
          "by": "xpath",
          "value": "//*[@id='done-button' and .//*[contains(translate(text(), ' ', ''), '發布') or contains(text(), 'Publish') or contains(text(), '儲存') or contains(text(), 'Save')]]",
          "weight": 32
        },
        {
          "by": "xpath",
          "value": "//*[@id='done-button']",
          "weight": 8
        },
        {
          "by": "xpath",
          "value": "//ytcp-button[@id='done-button']",
          "weight": 8
        }
      ]
    },
    "close_dialog_button": {
      "name": "上傳完成關閉視窗按鈕",
      "timeout": 20,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//*[@id='close-button']",
          "weight": 32
        },
        {
          "by": "xpath",
          "value": "//ytcp-button[@id='close-button']",
          "weight": 8
        }
      ]
    }
  },
  "known_popups": [
    {
      "name": "Trust Tiers 彈窗",
      "detect_xpath": "//yt-trust-tiers-wizard-dialog",
      "action": "click",
      "target_xpath": "//yt-trust-tiers-wizard-dialog//ytcp-button[.//div[contains(@class, 'fill')]]"
    },
    {
      "name": "Publish Anyway 仍要發布彈窗",
      "detect_xpath": "//*[contains(text(), '仍要發布') or contains(text(), 'Publish anyway')]",
      "action": "click",
      "target_xpath": "//*[contains(text(), '仍要發布') or contains(text(), 'Publish anyway')]/ancestor::ytcp-button | //*[contains(text(), '仍要發布') or contains(text(), 'Publish anyway')]"
    }
  ]
}