{
  "version": "1.0.0",
  "platform": "tiktok",
  "steps": {
    "file_input": {
      "name": "上傳檔案輸入框",
      "timeout": 15,
      "locators": [
        {
          "by": "xpath",
          "value": "//input[@type='file']",
          "weight": 62
        }
      ]
    },
    "caption_editor": {
      "name": "文案輸入框",
      "timeout": 15,
      "locators": [
        {
          "by": "xpath",
          "value": "//div[@contenteditable='true']",
          "weight": 70
        },
        {
          "by": "xpath",
          "value": "//*[@id=\"panel-video\"]/div[1]/div[1]/div[1]/div[1]/div[1]/div[2]/button[1]",
          "weight": 41
        },
        {
          "by": "xpath",
          "value": "//div[contains(@class, 'notranslate') and @contenteditable='true']",
          "weight": 8
        }
      ]
    },
    "post_button": {
      "name": "發佈按鈕",
      "timeout": 20,
      "locators": [
        {
          "by": "xpath",
          "value": "//button[@data-e2e='post_video_button']",
          "weight": 54
        },
        {
          "by": "xpath",
          "value": "//button[contains(., 'Post') or contains(., '發布') or contains(., '發佈')]",
          "weight": 9
        }
      ]
    },
    "success_indicator": {
      "name": "發佈成功指示標籤",
      "timeout": 15,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//div[contains(text(), 'Manage your posts') or contains(text(), 'View profile') or contains(text(), 'Upload another video') or contains(text(), '上傳另一支影片')]",
          "weight": 10
        },
        {
          "by": "xpath",
          "value": "//*[contains(text(), 'Uploaded') or contains(text(), '已發布') or contains(text(), '已發佈')]",
          "weight": 52
        }
      ]
    }
  },
  "known_popups": [
    {
      "name": "立即發佈確認彈窗",
      "detect_xpath": "//button[descendant::*[text()='立即發佈'] or contains(., '立即發佈')]",
      "action": "click",
      "target_xpath": "//button[descendant::*[text()='立即發佈'] or contains(., '立即發佈')]"
    },
    {
      "name": "TikTok TUXModal 彈窗",
      "detect_xpath": "//div[contains(@class, 'TUXModal')]//button[contains(@class, 'type-primary') or contains(@class, 'TUXButton--primary')]",
      "action": "click",
      "target_xpath": "//div[contains(@class, 'TUXModal')]//button[contains(@class, 'type-primary') or contains(@class, 'TUXButton--primary')]"
    }
  ]
}