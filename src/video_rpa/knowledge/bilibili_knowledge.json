{
  "version": "1.0.0",
  "platform": "bilibili",
  "steps": {
    "file_input": {
      "name": "上傳檔案輸入框",
      "timeout": 15,
      "locators": [
        {
          "by": "xpath",
          "value": "//input[@type='file']",
          "weight": 12
        },
        {
          "by": "xpath",
          "value": "//div[contains(@class, 'upload-area')]//input",
          "weight": 8
        }
      ]
    },
    "upload_area": {
      "name": "上傳區域",
      "timeout": 8,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//div[contains(@class, 'upload-area')]",
          "weight": 10
        }
      ]
    },
    "title_input": {
      "name": "標題輸入框",
      "timeout": 15,
      "locators": [
        {
          "by": "xpath",
          "value": "//input[contains(@placeholder, '请输入稿件标题') or contains(@placeholder, '稿件标题')]",
          "weight": 73
        },
        {
          "by": "xpath",
          "value": "//input[contains(@placeholder, '标题') or contains(@placeholder, 'Title')]",
          "weight": 12
        },
        {
          "by": "xpath",
          "value": "//input[contains(@class, 'input-val') and contains(@placeholder, '标题')]",
          "weight": 10
        }
      ]
    },
    "creation_declaration": {
      "name": "創作聲明輸入框",
      "timeout": 10,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//input[@placeholder='请选择符合您视频内容的创作声明' or contains(@placeholder, '创作声明')]",
          "weight": 20
        }
      ]
    },
    "creation_declaration_option": {
      "name": "創作聲明選項(无需标注)",
      "timeout": 8,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//li[contains(@class, 'bcc-option') and .//span[contains(text(), '内容无需标注')]]",
          "weight": 20
        },
        {
          "by": "xpath",
          "value": "//li[contains(@class, 'bcc-option') and contains(., '内容无需标注')]",
          "weight": 8
        },
        {
          "by": "xpath",
          "value": "//span[contains(text(), '内容无需标注')]",
          "weight": 8
        }
      ]
    },
    "description_input": {
      "name": "說明輸入框",
      "timeout": 10,
      "locators": [
        {
          "by": "css",
          "value": "div.ql-editor[contenteditable='true'][data-placeholder*='填写更全面的相关信息']",
          "weight": 70
        },
        {
          "by": "xpath",
          "value": "//div[contains(@class, 'ql-editor') and @contenteditable='true']",
          "weight": 8
        }
      ]
    },
    "category_dropdown": {
      "name": "分區下拉選單",
      "timeout": 10,
      "optional": true,
      "locators": [
        {
          "by": "css",
          "value": ".select-controller",
          "weight": 18
        }
      ]
    },
    "tag_input": {
      "name": "標籤輸入框",
      "timeout": 10,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//input[contains(@class, 'input-val') and contains(@placeholder, '创建标签')]",
          "weight": 73
        },
        {
          "by": "xpath",
          "value": "//input[contains(@placeholder, '按回车键Enter创建标签') or contains(@placeholder, '创建标签')]",
          "weight": 12
        }
      ]
    },
    "submit_button": {
      "name": "立即投稿按鈕",
      "timeout": 15,
      "locators": [
        {
          "by": "xpath",
          "value": "//*[contains(@class, 'submit-add') and contains(text(), '立即投稿')]",
          "weight": 65
        },
        {
          "by": "xpath",
          "value": "//span[contains(@class, 'submit') and contains(text(), '立即投稿')]",
          "weight": 12
        },
        {
          "by": "xpath",
          "value": "//*[contains(text(), '立即投稿') or contains(text(), 'Submit')]",
          "weight": 10
        }
      ]
    },
    "success_indicator": {
      "name": "投稿成功訊息",
      "timeout": 20,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//*[contains(text(), '稿件投递成功')]",
          "weight": 15
        },
        {
          "by": "xpath",
          "value": "//div[contains(@class, 'step-des') and contains(text(), '稿件投递成功')]",
          "weight": 12
        },
        {
          "by": "xpath",
          "value": "//*[contains(text(), '查看稿件')]",
          "weight": 10
        }
      ]
    }
  },
  "known_popups": [
    {
      "name": "活動參加分享彈窗",
      "detect_xpath": "//div[contains(@class, 'modal') or contains(@class, 'dialog')]//span[contains(text(), '完成') or contains(text(), '确定') or contains(text(), '关闭')]",
      "action": "click",
      "target_xpath": "//div[contains(@class, 'modal') or contains(@class, 'dialog')]//span[contains(text(), '完成') or contains(text(), '确定') or contains(text(), '关闭')]"
    },
    {
      "name": "本地未提交視頻草稿提示",
      "detect_xpath": "//*[contains(text(), '本地浏览器存在') and contains(text(), '未提交的视频')]",
      "action": "click",
      "target_xpath": "//*[contains(text(), '不用了') or contains(text(), '放弃') or contains(text(), '放棄')]"
    }
  ]
}