{
  "version": "1.0.0",
  "platform": "rednote",
  "steps": {
    "file_input": {
      "name": "上傳檔案輸入框",
      "timeout": 15,
      "locators": [
        {
          "by": "xpath",
          "value": "//input[@type='file']",
          "weight": 70
        }
      ]
    },
    "title_input": {
      "name": "標題輸入框",
      "timeout": 15,
      "locators": [
        {
          "by": "xpath",
          "value": "//input[contains(@placeholder, '填写标题') or contains(@placeholder, '標題')]",
          "weight": 70
        },
        {
          "by": "xpath",
          "value": "//input[contains(@class, 'd-input') and contains(@placeholder, '标题')]",
          "weight": 8
        }
      ]
    },
    "description_input": {
      "name": "說明輸入框",
      "timeout": 15,
      "locators": [
        {
          "by": "xpath",
          "value": "//div[contains(@class, 'tiptap') and contains(@class, 'ProseMirror') and @contenteditable='true']",
          "weight": 70
        },
        {
          "by": "xpath",
          "value": "//div[contains(@class, 'notranslate') and @contenteditable='true']",
          "weight": 8
        },
        {
          "by": "xpath",
          "value": "//*[@id='post-textarea']",
          "weight": 7
        }
      ]
    },
    "publish_button": {
      "name": "發佈按鈕",
      "timeout": 20,
      "locators": [
        {
          "by": "xpath",
          "value": "//xhs-publish-btn",
          "weight": 67
        },
        {
          "by": "xpath",
          "value": "//button[contains(@class, 'bg-red') and normalize-space(.)='发布']",
          "weight": 60
        },
        {
          "by": "xpath",
          "value": "//xhs-publish-btn//button",
          "weight": 55
        },
        {
          "by": "xpath",
          "value": "//button[contains(., '发布') and not(contains(., '发布笔记')) and not(contains(., '定时发布'))]",
          "weight": 50
        },
        {
          "by": "xpath",
          "value": "//span[normalize-space(text())='发布']",
          "weight": 12
        },
        {
          "by": "xpath",
          "value": "//span[contains(text(), '发布') and not(contains(text(), '发布笔记')) and not(contains(text(), '定时发布'))]",
          "weight": 11
        },
        {
          "by": "xpath",
          "value": "//div[contains(@class, 'publish-video')]//button[contains(., '发布')]",
          "weight": 10
        }
      ]
    },
    "success_indicator": {
      "name": "發佈成功訊息",
      "timeout": 20,
      "optional": true,
      "locators": [
        {
          "by": "xpath",
          "value": "//*[contains(text(), '发布成功') or contains(text(), 'Publish success')]",
          "weight": 55
        },
        {
          "by": "xpath",
          "value": "//div[contains(@class, 'success') and contains(text(), '成功')]",
          "weight": 12
        }
      ]
    }
  },
  "known_popups": [
    {
      "name": "常見確認或活動遮罩",
      "detect_xpath": "//div[contains(@class, 'modal') or contains(@class, 'dialog')]//button[contains(text(), '确定') or contains(text(), '我知道了') or contains(text(), '关闭')]",
      "action": "click",
      "target_xpath": "//div[contains(@class, 'modal') or contains(@class, 'dialog')]//button[contains(text(), '确定') or contains(text(), '我知道了') or contains(text(), '关闭')]"
    }
  ]
}